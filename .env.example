# AutoWorker environment template
AUTOWORKER_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://autoworker:autoworker@localhost:5432/autoworker

# Agent provider (never commit real credentials)
LLM_API_KEY=
LLM_MODEL=

# Evidence
EVIDENCE_ROOT=./data/evidence

# Web
VITE_API_URL=/api
